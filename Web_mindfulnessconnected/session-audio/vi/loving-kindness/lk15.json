{"locale":"vi","session_id":"loving-kindness","segment_key":"lk15","text":"Người này, cũng giống như bạn, có một đời sống nội tâm phong phú — những niềm vui và nỗi buồn, những hy vọng và nỗi sợ hãi. Hãy dành cho họ lòng tốt tương tự: Cầu mong bạn được an toàn. Cầu mong bạn được khỏe mạnh. Cầu mong bạn được hạnh phúc. Cầu mong bạn sống một đời an nhiên.","text_sha256":"2af58cba0c60b4248bce8f632ea04fd16359660a4d26bceafcf5070cda36efed","voice_name":"vi-VN-NamMinhNeural","word_boundaries":[{"text":"Người","offset":1000000,"duration":2625000},{"text":"này","offset":3625000,"duration":2875000},{"text":"cũng","offset":7375000,"duration":2125000},{"text":"giống","offset":9500000,"duration":2125000},{"text":"như","offset":11625000,"duration":1375000},{"text":"bạn","offset":13000000,"duration":3625000},{"text":"có","offset":18250000,"duration":1125000},{"text":"một","offset":19375000,"duration":1875000},{"text":"đời","offset":21250000,"duration":1875000},{"text":"sống","offset":23125000,"duration":2625000},{"text":"nội","offset":25750000,"duration":1625000},{"text":"tâm","offset":27375000,"duration":2375000},{"text":"phong","offset":29750000,"duration":2000000},{"text":"phú","offset":31750000,"duration":3875000},{"text":"những","offset":37500000,"duration":2375000},{"text":"niềm","offset":39875000,"duration":2125000},{"text":"vui","offset":42000000,"duration":2250000},{"text":"và","offset":44250000,"duration":1125000},{"text":"nỗi","offset":45375000,"duration":1875000},{"text":"buồn","offset":47250000,"duration":3500000},{"text":"những","offset":52500000,"duration":2500000},{"text":"hy","offset":55000000,"duration":1625000},{"text":"vọng","offset":56625000,"duration":2750000},{"text":"và","offset":59375000,"duration":1375000},{"text":"nỗi","offset":60750000,"duration":2250000},{"text":"sợ","offset":63000000,"duration":2250000},{"text":"hãi","offset":65250000,"duration":4125000},{"text":"Hãy","offset":77750000,"duration":2125000},{"text":"dành","offset":79875000,"duration":237