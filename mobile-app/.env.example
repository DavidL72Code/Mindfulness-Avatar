# These values are public client configuration, not server secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Production must use HTTPS. Local HTTP is accepted only in Expo development builds.
EXPO_PUBLIC_MINDFULNESS_API_BASE_URL=https://multilingual-virtual-assistant.onrender.com

# Optional. Leave blank to disable the in-app support submission form.
EXPO_PUBLIC_SUPPORT_FORM_ENDPOINT=

# Where the in-app support link sends mail. Falls back to a placeholder.
EXPO_PUBLIC_SUPPORT_EMAIL=
